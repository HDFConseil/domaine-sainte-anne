{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.domainedesainteanne.fr" }], "destination": "https://domainedesainteanne.fr/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "project-lsusn.vercel.app" }], "destination": "https://domainedesainteanne.fr/:path*", "permanent": true },
    { "source": "/actualites.html", "destination": "/actualites", "permanent": true },
    { "source": "/actualites/", "destination": "/actualites", "permanent": true },
    { "source": "/en/news/", "destination": "/en/news", "permanent": true },
    { "source": "/vendor/:path*", "destination": "/", "permanent": false },
    { "source": "/package.json", "destination": "/", "permanent": false },
    { "source": "/package-lock.json", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/actualites", "destination": "/api/actualites?lang=fr" },
    { "source": "/actualites/sitemap.xml", "destination": "/api/actualites?view=sitemap" },
    { "source": "/actualites/derniere.json", "destination": "/api/actualites?view=latest&lang=fr" },
    { "source": "/actualites/:slug", "destination": "/api/actualites?lang=fr&slug=:slug" },
    { "source": "/en/news", "destination": "/api/actualites?lang=en" },
    { "source": "/en/news/latest.json", "destination": "/api/actualites?view=latest&lang=en" },
    { "source": "/en/news/:slug", "destination": "/api/actualites?lang=en&slug=:slug" }
  ]
}
